# Copy to .env and fill in. .env is gitignored.

# The only API key the project needs. Embeddings and reranking run locally.
ANTHROPIC_API_KEY=sk-ant-...

# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres on 5432.
DATABASE_URL=postgresql://notekit:notekit@localhost:5433/notekit

# Optional: Langfuse tracing. Without these the app runs exactly as before —
# tracing is a no-op, not a requirement. Keys from https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Deployment only. Leave both unset locally.
#
# SITE_PASSWORD puts one shared password in front of the whole API. Unset means
# no gate, which is what you want on your own machine. It is a lock on the front
# door, not authentication — see src/notekit/auth.py.
# SITE_PASSWORD=

# Browser origins allowed to call the API, comma separated. The deployed
# frontend's URL goes here; without it the browser blocks every request.
# ALLOWED_ORIGINS=https://notekit.vercel.app
